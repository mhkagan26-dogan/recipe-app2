<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- App Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🍳 Delicious Recipes"
            android:textColor="#212121"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <!-- Recipe Card 1: Red Lentil Soup -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥣 Red Lentil Soup"
                android:textColor="#D32F2F"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ 25 Min | ⚡ 180 kcal | 🌱 Vegetarian"
                android:textColor="#757575"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingredients:"
                android:textColor="#212121"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 1 cup red lentils\n• 1 onion &amp; 1 carrot\n• 1 tbsp butter &amp; flour\n• 5 cups hot water, salt, black pepper"
                android:textColor="#424242"
                android:textSize="14sp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instructions:"
                android:textColor="#212121"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Saute chopped onion and carrot in butter.\n2. Add washed lentils and flour, stir well.\n3. Pour water, simmer until soft, then blend."
                android:textColor="#424242"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Recipe Card 2: Classic Menemen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍳 Classic Menemen"
                android:textColor="#E65100"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ 15 Min | ⚡ 220 kcal | 🍳 Breakfast"
                android:textColor="#757575"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingredients:"
                android:textColor="#212121"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 2 tomatoes &amp; 2 green peppers\n• 2 eggs\n• 2 tbsp olive oil, salt, red pepper flakes"
                android:textColor="#424242"
                android:textSize="14sp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instructions:"
                android:textColor="#212121"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Saute peppers in olive oil.\n2. Add diced tomatoes, simmer until juicy.\n3. Beat eggs gently into the pan and cook."
                android:textColor="#424242"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Recipe Card 3: Baked Rice Pudding -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍮 Baked Rice Pudding"
                android:textColor="#6A1B9A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ 40 Min | ⚡ 280 kcal | 🍨 Dessert"
                android:textColor="#757575"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingredients:"
                android:textColor="#212121"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 1 liter milk &amp; 1/2 cup rice\n• 1 cup sugar\n• 2 tbsp cornstarch &amp; 1 tsp vanilla extract"
                android:textColor="#424242"
                android:textSize="14sp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instructions:"
                android:textColor="#212121"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Boil rice in water, add milk and sugar.\n2. Mix cornstarch with water, stir into pot.\n3. Pour into ramekins, bake until golden top."
                android:textColor="#424242"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>