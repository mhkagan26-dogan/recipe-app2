<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Uygulama Başlığı -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🍳 Nefis Yemek Tarifleri"
            android:textColor="#212121"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <!-- Tarif Kartı 1: Mercimek Çorbası -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥣 Süzme Mercimek Çorbası"
                android:textColor="#D32F2F"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ 25 Dk | ⚡ 180 kcal | 🌱 Vejetaryen"
                android:textColor="#757575"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Malzemeler:"
                android:textColor="#212121"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 1 su bardağı kırmızı mercimek\n• 1 adet kuru soğan &amp; havuç\n• 1 yemek kaşığı tereyağı &amp; un\n• 5 su bardağı sıcak su, tuz, karabiber"
                android:textColor="#424242"
                android:textSize="14sp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hazırlanışı:"
                android:textColor="#212121"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Soğan ve havucu tereyağında soteleyin.\n2. Yıkanmış mercimeği ve unu ekleyip kavurun.\n3. Suyu ekleyip mercimekler yumuşayana kadar pişirin ve blender'dan geçirin."
                android:textColor="#424242"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Tarif Kartı 2: Menemen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍳 Pratik Menemen"
                android:textColor="#E65100"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ 15 Dk | ⚡ 220 kcal | 🍳 Kahvaltılık"
                android:textColor="#757575"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Malzemeler:"
                android:textColor="#212121"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 2 adet domates &amp; 2 adet yeşil biber\n• 2 adet yumurta\n• 2 yemek kaşığı sıvı yağ, tuz, pul biber"
                android:textColor="#424242"
                android:textSize="14sp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hazırlanışı:"
                android:textColor="#212121"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Biberleri doğrayıp sıvı yağda soteleyin.\n2. Küp doğranmış domatesleri ekleyip suyunu çekene kadar pişirin.\n3. Yumurtaları kırıp hafifçe karıştırarak pişirin."
                android:textColor="#424242"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Tarif Kartı 3: Fırında Sütlaç -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍮 Fırında Sütlaç"
                android:textColor="#6A1B9A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ 40 Dk | ⚡ 280 kcal | 🍨 Tatlı"
                android:textColor="#757575"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Malzemeler:"
                android:textColor="#212121"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• 1 litre süt &amp; 1 çay bardağı pirinç\n• 1 su bardağı şeker\n• 2 yemek kaşığı nişasta &amp; 1 paket vanilya"
                android:textColor="#424242"
                android:textSize="14sp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hazırlanışı:"
                android:textColor="#212121"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Pirinci suyla haşlayın. Sütü ve şekeri ekleyin.\n2. Nişastayı az suyla açıp karışıma ekleyin ve koyulaşana kadar pişirin.\n3. Güveç kaplarına paylaştırıp fırının üst rafında üzeri kızarana kadar pişirin."
                android:textColor="#424242"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>